generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trades        Trade[]
  tasks         Task[]
  notes         Note[]
  vaultEntries  VaultEntry[]
  drawings      Drawing[]
}

model VaultEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  type        VaultType
  title       String?
  content     String    @db.Text
  imageUrl    String?
  pinned      Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([pinned])
}

enum VaultType {
  GOAL
  QUOTE
  IMAGE
  DREAM
  REMINDER
  MILESTONE
}

model Trade {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  mt5Ticket       BigInt?  @unique  // Ticket de MT5 (set por el bot al crear). Nullable en trades MANUAL. BigInt: tickets reales ~9e9 desbordan INT4.

  source          TradeSource
  pair            String
  direction       TradeDirection

  // Trades que NO siguen la estrategia ICT modular (ej. bug de Sizing/SL):
  // se guardan como evidencia historica pero quedan FUERA de toda metrica.
  excludeFromStats Boolean @default(false)
  // Multi-user (Fase 2): trades del bot visibles para todos los usuarios.
  // Los manuales quedan en false (privados de su dueño).
  isShared        Boolean @default(false)

  qualityRating   QualityRating?
  biasHTF         BiasHTF?
  inKillzone      Boolean?
  sessionType     SessionType?
  killzone        String?

  entryPrice      Float
  stopLoss        Float
  takeProfit1     Float?
  takeProfit2     Float?
  exitPrice       Float?

  positionSize    Float
  riskPercent     Float
  riskUSD         Float

  poolType        String?
  sweepTimeframe  String?
  fvgSizePips     Float?
  timeSweepToChoch Int?
  spreadAtEntry   Float?
  atrAtEntry      Float?

  tp1Hit          Boolean  @default(false)
  tp2Hit          Boolean  @default(false)
  beHit           Boolean  @default(false)
  rAchieved       Float?
  pnlUSD          Float?

  entryTime       DateTime
  exitTime        DateTime?

  preTradeNotes   String?  @db.Text
  postTradeNotes  String?  @db.Text
  notes           String?  @db.Text
  screenshotUrl   String?

  confluences     TradeConfluence[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([entryTime])
  @@index([pair])
  @@index([source])
  @@index([isShared])
  @@index([excludeFromStats])
}

model TradeConfluence {
  id          String   @id @default(cuid())
  tradeId     String
  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  conceptKey  String
  createdAt   DateTime @default(now())

  @@index([tradeId])
  @@index([conceptKey])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])

  title       String
  description String?    @db.Text
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  tags        String[]

  forClaudeCode Boolean  @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  title       String
  content     String   @db.Text
  category    String?
  tags        String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model NewsEvent {
  id          String   @id @default(cuid())

  title       String
  country     String
  currency    String
  impact      NewsImpact

  scheduledAt DateTime
  actual      String?
  forecast    String?
  previous    String?

  source      String   @default("ForexFactory")

  createdAt   DateTime @default(now())

  @@index([scheduledAt])
  @@index([currency])
  @@index([impact])
}

model BotConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

enum DrawingType {
  HORIZONTAL_LINE
  VERTICAL_LINE
  TRENDLINE
  RECTANGLE
  TEXT
  LONG_POSITION
  SHORT_POSITION
}

model Drawing {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  pair       String      // "EURUSD" | "GBPUSD"
  timeframe  String?     // null = visible en todos los TFs
  type       DrawingType

  // Geometría flexible: { points: [{time, price}], text, ... }
  geometry   Json        @default("{}")

  // Para LONG_POSITION / SHORT_POSITION
  entryPrice Float?
  slPrice    Float?
  tpPrice    Float?
  volume     Float?
  riskUsd    Float?
  rRatio     Float?

  color      String      @default("#C9A96E")
  label      String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId, pair])
}

model Candle {
  id          String   @id @default(cuid())
  pair        String   // "EURUSD" | "GBPUSD"
  timeframe   String   // "M1" | "M3" | "M5" | "M15" | "H1" | "H4"
  timestamp   DateTime // open time de la vela (UTC)
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([pair, timeframe, timestamp])
  @@index([pair, timeframe, timestamp(sort: Desc)])
}

model BotState {
  id            String   @id @default(cuid())
  symbol        String   @unique // "EURUSD" | "GBPUSD"
  updatedAt     DateTime @updatedAt

  // Contexto HTF / sesión
  biasH4        String?  // "BULLISH" | "BEARISH" | "NEUTRAL"
  biasD1        String?
  killzone      String?  // "LONDON_KZ" | "NY_AM" | "NY_LUNCH" | "SESSION_NO_KZ" | "OUTSIDE"

  // Precio en vivo (Bug #3): el EA lo manda cada 5s; el chart dibuja la línea bid.
  currentBid    Float?
  currentAsk    Float?

  // Estado vivo (arrays JSON)
  fvgs          Json     @default("[]") // [{ tf, side, top, bot, quality, state }]
  sweeps        Json     @default("[]") // [{ tf, level, type, timestamp }]
  markers       Json     @default("[]") // [{ type, price, label, tf }]
  chochState    String?  // "PENDING" | "CONFIRMED" | "NONE"

  // Narración didáctica
  currentAction String?  // texto corto: "Aguardando killzone NY AM…"
  reasoning     String?  @db.Text
  nextStep      String?

  @@index([updatedAt])
}

model BotEvent {
  id          String   @id @default(cuid())

  type        String
  pair        String?
  message     String   @db.Text
  metadata    Json?

  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([type])
}

enum UserRole {
  OWNER
  MEMBER
}

enum TradeSource {
  BOT
  MANUAL
}

enum TradeDirection {
  LONG
  SHORT
}

enum QualityRating {
  HIGH
  MEDIUM
  LOW
}

enum BiasHTF {
  BULLISH
  BEARISH
  NEUTRAL
}

enum SessionType {
  LONDON
  LONDON_KZ
  NY_AM
  NY_LUNCH
  NY_PM
  OUTSIDE
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NewsImpact {
  LOW
  MEDIUM
  HIGH
}
